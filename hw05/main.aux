\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Nominal feedforward disturbance response with \(\sigma =0.05\) on \(\hat  w\). Steady jitter is the rms of the signal about its own mean on \([3,5]~\mathrm  {s}\). The full-horizon rms of \(u\) is dominated by the deterministic spike.}}{9}{table.caption.7}\protected@file@percent }
\newlabel{tab:noise}{{4}{9}{Nominal feedforward disturbance response with \(\sigma =0.05\) on \(\hat w\). Steady jitter is the rms of the signal about its own mean on \([3,5]~\mathrm {s}\). The full-horizon rms of \(u\) is dominated by the deterministic spike}{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Disturbance-sensor noise, \(\sigma =0.05\), and the low-pass \(20/(s+20)\). The upper row uses the full scale of the spike. The lower row is \([3,5]~\mathrm  {s}\) only; the output scale there is \(10^{-3}\). Actuator chatter is obvious in \(u\). The speed barely moves.}}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:noise}{{4}{9}{Disturbance-sensor noise, \(\sigma =0.05\), and the low-pass \(20/(s+20)\). The upper row uses the full scale of the spike. The lower row is \([3,5]~\mathrm {s}\) only; the output scale there is \(10^{-3}\). Actuator chatter is obvious in \(u\). The speed barely moves}{figure.caption.8}{}}
